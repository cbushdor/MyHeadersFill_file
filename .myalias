# Interaction with twiter
twit(){ # begin twit()
# Twitter status update bot by http://360percents.com
# Author: Luka Pusic <pusic93@gmail.com>

#REQUIRED PARAMS
#username="user@email.com"
	username="dorey_s"
		password="kaxYOs3p"
		tweet="$*" #must be less than 140 chars
		cookieFileName="cookie.txt.$$";

#EXTRA OPTIONS
	uagent="Mozilla/5.0" #user agent (fake a browser)
		sleeptime=0 #add pause between requests

		if [ $(echo "${tweet}" | wc -c) -gt 140 ]; then
			echo "[FAIL] Tweet must not be longer than 140 chars!" && exit 1
				fi

				touch "${cookieFileName}" #create a temp. cookie file

#INITIAL PAGE
				echo "[+] Fetching twitter.com..." && sleep $sleeptime
				echo "${cookieFileName}"
# we get file that initiate connection
				initpage=`curl -s -b "${cookieFileName}" -c "${cookieFileName}" -L --sslv3 -A "$uagent" "https://mobile.twitter.com/session/new"`
# we get the token from this file stored in initpage
				token=`echo "$initpage" | grep "authenticity_token" | sed -e 's/.*value="//' | sed -e 's/" \/>.*//'`
				echo "--->$token"

#LOGIN
				echo "[+] Submitting the login form..." && sleep $sleeptime
# we login at the twitter page
				loginpage=`curl -s -b "${cookieFileName}" -c "${cookieFileName}" -L --sslv3 -A "$uagent" -d "authenticity_token=$token&username=$username&password=$password" "https://mobile.twitter.com/session"`

#HOME PAGE
				echo "[+] Getting your twitter home page..." && sleep $sleeptime
				homepage=`curl -s -b "${cookieFileName}" -c "${cookieFileName}" -L -A "$uagent" "http://mobile.twitter.com/"`

#TWEET
				echo "[+] Posting a new tweet..." && sleep $sleeptime
				tweettoken=`echo "$homepage" | grep "authenticity_token" | sed -e 's/.*value="//' | sed -e 's/" \/>.*//' | tail -n 1`
				echo "oooo)$tweettoken"
				update=`curl -s -b "${cookieFileName}" -c "${cookieFileName}" -L -A "$uagent" -d "authenticity_token=$tweettoken&tweet[text]=$tweet&tweet[display_coordinates]=false" "http://mobile.twitter.com/"`

#LOGOUT
				echo "[+] Logging out..."
				logout=`curl -s -b "${cookieFileName}" -c "${cookieFileName}" -L -A "$uagent" "http://mobile.twitter.com/session/destroy"`

				rm "${cookieFileName}"
} # end twit()

# transform file *.pdf to *.pdf but file file na contains spaces it replaces them with _ character
trans(){
	for i in `ls *pdf|sed 's! !_!g'`; do export u=`echo $i|sed 's!_! !g'`;echo "$u --> $i"; mv "$u" $i;done
}

# text file to pdf command line
tf2p(){
	[[ "$1" =~ ((test[0-9]).sh) ]] ; if [[ ${BASH_REMATCH[*]} -gt 0 ]] ; then cat  ${BASH_REMATCH[1]} | text2pdf -o ${BASH_REMATCH[2]}.pdf && echo "${BASH_REMATCH[1]} -> ${BASH_REMATCH[2]}.pdf" ; else echo "$1 not found"; fi
}

# Creates from pod the corresponding html documentation
docPerl6(){

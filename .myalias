						echo "regarde s'il y a bien le compte: ${a}**${a} = $n ---> ${f}/${n} <br>matrice carr&eacute; $c/$a $u/$a<br>As tu bien re&ccedil;u $u poil(s) de cul sur $n poil(s) de cul(s)  `date`"| mail -s"`date;hostname;`" $m

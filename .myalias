vhelp(){
   export e="$1";
   mv ${e} ${e}.old; 
   vi ${e}.old;
   mv ${e}.old ${e}
}

# Used when taging MAOP Version
maoptagVersion(){
   # Usage:
   #        maoptagVersion "comment"
   #        maoptagVersion

   export oldpwd=$(pwd);
   cd /Users/sdo/Downloads/MyMAOP/V1/Sites/cgi-bin;
   export ALBUM_VERSION="$(grep Version ./album.cgi|cut -d':' -f2|sed 's/\ \{1,\}//g')";
   echo "---->$ALBUM_VERSION";
   sed '1,30s/\(my \$VERSION=\"\).\{1,\}$/\1'"$ALBUM_VERSION"'\";/' ./album.cgi>&./album.cgi.tmp
   mv album.cgi.tmp album.cgi
   if [[ $# > 0 ]] ; then
      echo "Future comment $1";
      git tag -a v${ALBUM_VERSION} -m "$1 (current version ${ALBUM_VERSION})."
   else
      git tag -a v${ALBUM_VERSION} -m "current version ${ALBUM_VERSION}."
   fi
   cd ${oldpwd}
}

# MAOP gets saved data from trip (only days +1 (more than one day) 1 (exactly one day) -1 (less than one day)
maopBackupDateAlbum(){
   # usage: backupDateMaop n wher it can be 0 where 0 is today -760 is 760 days ago 
   export oldpwd=$(pwd);
   cd /Users/sdo/Sites/cgi-bin
   pwd;

   if [[ $# -eq 0 ]] ; then
      echo "nothin";
      export mti=0;
   else
      echo "better than nothin";
      export mti=$1;
   fi
   find ./album -type f -mtime ${mti} -print0 | tar cvzf files.tar.gz --files-from=- --null --exclude=\*backup\*
   cd ${oldpwd}
}


alive(){
   export final="";
   while read -r fname; do
      export string="$fname";
      if [[ $string =~ "PING" ]] ; then
      #   echo "---->$fname<==="
         export final="$(echo $string|sed 's/PING //')";
         export final="$(echo $final|sed 's/:.*$//')";
      #   echo "oooooo>${Green}$final${Color_Off}<oooo";
      elif [[ $string =~ "transmitted" ]] ; then
         export final="$final - $(echo "[${Yellow}$string${Color_Off}]")";
      fi
      #echo $string;
   done <<< "`ping -c 1 $1`";
   if [[ $final =~ "0.0% packet loss" ]] ; then
      echo "${Green}Ok alive${Color_Off} $final";
   else
      echo "${Red}Not ok alive${Color_Off} $final";
   fi
}

start(){
   if [[ -f "~/\ .myalias" ]] ; then
      my ~/\ .myalias ~/.myalias;
   fi
   source ~/.myalias  ~/.profile
}


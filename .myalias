# vi modified: add header if *.pm6 *.p6 *pl6
# to to use export memory to optimise script
vi_old(){
#	echo $@

		for i in $@
			do
#echo "++++++++>$i";

				echo "$i" | awk -v pn="$i" -v user="$USER" '\
					\
					BEGIN{\
						"date +%Y-%m-%d_%H:%M:%S" | getline date; \
					}\
			\
				/\.(p6|pl6|t|pm6)$/ \
				{\
#			print "MIGHT CREATE @@@@@@>" a "    " date;\
					print $1
					if (system("test ! -f " pn) == 0){ \
#print "---BAG DEN------->"\

						if(match($1,/\.(p6|pl6|t)$/)){\
							system("echo \"#!/usr/bin/env perl6  \">" pn) ;\
								system("echo \"\">>" pn) ;\
								system("echo \"use v6 ; \">>" pn) ;\
								system("echo \"\">>" pn) ;\
								system("echo \"# Book: Think Perl 6 (pdf v0.5.3 May 2018)\">>" pn) ;\
						}\
						else {\
							system("echo \"# Book: Think Perl 6 (pdf v0.5.3 August 2017)\">" pn) ;\
						}\
						system("echo \"# Program:\" " pn ">>" pn) ;\
							system("echo \"# User:\" " user ">>" pn) ;\
							system("echo \"# Date:\" " date ">>" pn) ;\
							system("echo \"\">>" pn) ;\
							if(match($1,/\.(pm6)$/)){\
								split(pn,a,"\.pm6");
								system("echo \"unit module \" " a[1] "\":ver<0.0.0.0>:auth<Sebastien Dorey - SDO (sebastien.dorey@laposte.net)> ;\" >>" pn) ;\
							}\
						system("chmod 700 " pn);\
#print "---END DEN------->"\
					}
				}'
			done
				/usr/bin/vi -o $@
}


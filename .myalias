# resize video *.mp4 to 5 minutes $$-myout*.mp4
my_ffmep(){ # Begin my_ffmep()
   export myin="$1";
   echo proc="echo $(($$))";
   ffmpeg-bar -ss 00:00:00.000 -i ${myin} -vf "drawtext=text='XX':x=1920:y=1070:fontsize=24:fontcolor=black:box=1:boxcolor=black@0.5: boxborderw=5" -to 00:04:59.973 $$-myout${myin} 
} # End my_ffmep()

# We redefine lp as mylp with specific options. We had probless to printout file with .html extenions and contents.
# Hence we bypass by creating a file as pdf and, then printout for watevever file (it ias to be text ...).
mylp(){
# Standard options check https://stuff.mit.edu/afs/athena/astaff/project/opssrc/cups/cups-1.4.4/doc/help/options.html
# https://www.cups.org/doc/man-lpoptions.html
# options used are:  lpoptions -p HP_OfficeJet_Pro_6970 -o sides=two-sided-long-edge -o blackplot -o number-up=1
   for w in "$@" ; do 
# We check if we have extension .pdf int file name. If not we create same file name with the .pdf extension (case insensitive)
      export sol=$(export u=$(echo "$w" |grep -iv '\.pdf$'|sed 's/\(.*\)/\1.pdf/');[ ! -z "$u" ] && echo "$u" || echo "$w");

# We check if original file name exist ($w) we create a file 
   [ -f "$w" ] && ( 
         echo "Printing $w";
         ( [ ! -f "$sol" ] ) && ( 
            echo "$w exists but $sol not" ;  
            txt2pdf -A3 $w > $sol;
# Soluce found to print
            lp -o fit-to-page -o media=A3 -o portrait $sol ;
            rm -f $w.pdf ;
            ) || (
               echo "$w exists and, $sol too" ;
               lp -o fit-to-page -o media=A3 -o portrait $sol ;
               rm -f $w.pdf ;
               ) 
         ) || echo "$w doesn't exist"

      done; 
}


   git add .;git commit -m "Updated..." .;git push
}

# Gets last log(s) from httpd
gllfh(){
   httpdlogerr|grep "$(httpdlogerr|tail -n 1|sed -e 's/^.*\([a-z]\{3\}\ \{1\}[a-z]\{3\}\ \{1\}[0-9]\{2\}\ \{1\}[0-9]\{2\}\:[0-9]\{2\}\:[0-9]\{2\}\).*/\1/i')"
}

# Input and Sed and Debug mode
isd(){
#echo $(printf '%q' "$1")
# Instructions to executes
   export ie="$(printf '%q' $1)"
# Instructions for sed
      export is="$(printf '%q' $2)"
# Instructions result
#export ir="$(print $(echo $1|sed $2)')"
      export ir=""
      for i in $(echo $1|sed -n $2); do
         if [[ -z "${ir}" ]] ; then 
            export ir="$i"
         else
            export ir="${ir}\\\n$i"
               fi
               done
               print $ie
               print $is
               print $ir
}


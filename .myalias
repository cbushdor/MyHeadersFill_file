   export PATH="$BACKUP_PATH";
   unset BACKUP_PATH;
}

# Creates Markdown From Vimdoc
UpdateREADME.md(){
   export HOMEDIR_CPY="$(pwd)/.."
      for i in *.txt; do 
         vim -c TOhtml -c wqa $i ;
   html-to-markdown $i.html;
   mv dist/$i.html.md ./README.md; 
   rm -r dist *.html;
   vim -c MarkdownPreview -c q ./README.md;
   done
      echo "*****>${HOMEDIR_CPY}";
   for i in $(find .. -iname "README.md"  -print); do
      cp -v "$(pwd)/README.md" $i ;
   done
      unset HOMEDIR_CPY;
}


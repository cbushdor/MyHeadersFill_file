# Launch Planner
mplanner(){
   export pa=`pwd`;
   export MD=`date "+%Y-%m-%d %H:%M:%S"`
   export MDY=`date "+%Y"`
   cd ~/Documents/My-Proj/LGV
   /usr/bin/git pull  >~/.mytrash 2>&1;
   #open -W -a Planner
         planner
   #>~/.mytrash 2>&1;
      /usr/bin/git commit -m "Planner year $MDY" *  >~/.mytrash 2>&1; 
   cd ..;git push >~/.mytrash 2>&1;
   /usr/bin/git push;/usr/bin/git pull;
   cp -p ~/MyDocuments/My-Proj/LGV/* ~/Sites/Project/LGV/mapr/Gantt
   cp -p ~/MyDocuments/My-Proj/LGV/*.html ~/Downloads/MySchedule/
   cp -p ~/MyDocuments/My-Proj/LGV/*.planner ~/Downloads/MySchedule/
   cp -p ~/Downloads/MySchedule/*.html ~/Sites/Project/LGV/mapr/Gantt
   cp -p ~/Downloads/MySchedule/*.planner ~/Sites/Project/LGV/mapr/Gantt
   cd ~/Downloads/MySchedule/
   /usr/bin/git commit -m "Planner year $MDY" *  >~/.mytrash 2>&1; 
   /usr/bin/git push >~/.mytrash 2>&1;
   /usr/bin/git push;/usr/bin/git pull;
   cd $pa
   rm -f ~/.mytrash
}


# We check if file is newer if so, we copy with verbose message
function mycpy(){
   if test  "$1" -nt "$2"
      then
         echo "$1 is newer than $2 we copy"
         cp -vp "$1" "$2" 
#else
#echo "$2 is newer than $1 we can't copy"
         fi
}

# Super copy with synchronisation (rsync)
function scopy(){
   src="$1";                             # We get first parameter that is source (path)
   dst="$2";                             # We get second parameter that is destination (path)
   cd $src; # We are in the source directory
   cleanTemp; # We make some cleaning temp file
   myTxtFile="$(echo "${src}"|sed 's/^.*\/\([^\/]\{1,\}\)$/\1/').txt";
   #echo "---->${myTxtFile}<----";
   #return;
   vimd="${src}/$3";                     # Ask to update vimdoc before starting
   #echo -n "--->$src/";                  # We print sourcec path
   echo "ooooo>${vimd}<ooooo";
   if [ -d "$src/" ] ; then              # We check if source is a directory
      echo " ${Green}ok${Color_Off}.";   # Source directory exists
   else                                  # case if source is not a directory
      echo " ${Red}not ok${Color_Off}."; # Source directory doesn't exist
      return -1;                         # We exit function
   fi
   echo -n "--->$dst/";                  # We print destination path
   if [ -d "$dst" ] ; then               # We check if destination is a directory
      echo " ${Green}ok${Color_Off}.";   # Destination directory exists
   else
      echo " ${Red}not ok${Color_Off}."; # Destination directory doesn't exist
      return -1;                         # We exit function
   fi
   echo "before";
   if [[ -d "$vimd" ]] ; then # We check if directory where doc is valid
      echo "We go into ${vimd}";
      cd $vimd; # We go in directory
                  # and we update doc
      vimdoc2md -y -s ${myTxtFile} -d README.md  -u -m -mp ../man/man1 
      cp README.md ..; # Coppy in $vimd once updated or created
      #echo "after cp README.md ..;";
      #return;
      #   echo "After return;";
      #   echo "Update all subdirt
      #   return;
   fi
   cd ${src};
   cpgit; # update in sub dirs these files ./README.md ./README.pod ./CC-BY-NC-3.0.md ./.gitignore
   echo "------------------------------------------------------";
   echo "---------------GenDoc---------------------------------";
   #	genDocMdFromVimHelp "$src";
   echo "------------------------------------------------------";
   rsync -uav --exclude  "git" $src/* $dst; # Remote sync, is a command-line 
                           # tool for synchronizing files and directories locally 
                           # # from $src (source) to $dst (destination)
                           # -a synchronizes the directories recursively. 
                           #    Keeping the ownership of users and groups, 
                           #    permissions, symlinks and timestamps.
                           # -u skip files that are newer on the receiver.
                           # -v verbose.
   rsync -uav --exclude  ".git" $src/.* $dst; # Remote sync, is a command-line 
                           # tool for synchronizing files and directories locally 
                           # # from $src (source) to $dst (destination)
                           # -a synchronizes the directories recursively. 
                           #    Keeping the ownership of users and groups, 
                           #    permissions, symlinks and timestamps.
                           # -u skip files that are newer on the receiver.
                           # -v verbose.
   cd $dst; # We go to destination directory
   cleanTemp; # We make some cleaning temp file
   #cpgit; # Copy recursively files s.a ./README.md ./README.pod ./CC-BY-NC-3.0.md ./.gitignore
   #	echo "cp ${docdst} ${dst}/doc/README.md"
   #	cp ${docdst} ${dst}/doc/README.md
   pwd;
   echo "Need now to use git if needed\!";
   #echo "We are in ${Green}$(pwd)${Color_Off}!";
}

function genDocMdFromVimHelp(){
plugName=$(printf "%s" $(pwd) |sed 's/\(\/*[^\/]*\/\)*//g')
      echo "------->${plugName}"
      docsrc="$1/doc/${plugName}.txt"
      echo "---SRC---->${docsrc}"
      docdst="$1/doc/${plugName}.md";
   echo "---DST---->${docdst}"
      echo "vimdoc2html ${docsrc}; pandoc -f html -t markdown ${docsrc}.html -o ${docdst}"
      vimdoc2html ${docsrc}; pandoc -f html -t markdown ${docsrc}.html -o ${docdst}
   rm ${docsrc}.html
}

# We want to check smtp addr i.e
_csmtp(){
   if [ $# -eq 2 ] ; then
      echo "ADDR: $1 ; PORT: $2"
         nc -zv $1 $2
         echo "--------"
         ping -c 1 $1
         echo "--------"
         nmap -A -T4 -Pn -p $2 $1
   else
      echo "Error: csmtpA addr port"
         fi
}

my_corresp(){
   export cur_path="$(pwd)"
   export fileCorresp="./.mycorrespFile"
   export myCorrespPath="${HOME}/Documents/Documents/Correspondances"
   #cd ${HOME}/Downloads
   cd ${myCorrespPath}
   if [[ -f "$1" ]] ; then
      echo "$(echo "$1"|cut -d'.' -f1)">${fileCorresp}
      echo "+ $1 ${Green}found${Color_Off}"
   else
      if [[ ! -z "$1" ]] ; then
         echo "*${BRed}$1 ${Error}not found${Color_Off}"
         return -11;
      fi
   #   echo "* ${corresp} ${Green}found${Color_Off}"
   #   echo "$(echo "${corresp}.pdf"|cut -d'.' -f1)">${fileCorresp}
   fi
   export corresp="$(echo "$(cat ${fileCorresp})")";
   echo "${fileCorresp} ---> ${BCyan}${corresp} is propcessing...${Color_Off}";
   cp ${corresp}.pdf ${corresp}_cpy.pdf
   zip -r -s 40 ${corresp}_.zip ${corresp}_cpy.pdf
   echo ${cur_path}
   mv ${corresp}_.z* ${HOME}/Documents/My-Proj/doc/Doc/Correspondances
   rm ${corresp}_cpy.pdf
   cd ${HOME}/Documents/My-Proj/doc/Doc/Correspondances
   export dte="$(date)"
   for i in $(ls ${corresp}_.z*); do
      echo "Working on ${i}";
      git add ${i};
      git commit -m "Update on ${dte} ... ${i}" ${i};
   done
   git push;
   cd "${cur_path}"
   unset cur_path
   unset fileCorresp
   unset corresp
   unset dte
}



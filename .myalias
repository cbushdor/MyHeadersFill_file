# make some cleanings
function sweep(){
	#cd $HOME;
	#cd -; 
	brew cleanup; 
	find $HOME -iname  "*lightning*talk*" ! -path ./Downloads/\*  -exec rm -rf {} \; -print ; 
	find $HOME -name ".metadata" -exec rm -rf {} \; -print; 
	find $HOME -name ".xv*"  -exec rm -rf {} \; -print; 
	find $HOME -name ".*sw*" -exec rm -f {} \; -print; 
	find $HOME -name ".DS_Store" -exec rm -f {} \; -print; 
	find $HOME -name ".localized" -exec rm -rf {} \; -print; 
	find $HOME -name "._*" -exec rm -rf {} \; -print; 
}

# Used when taging MAOP Version
maoptagVersion(){
   # Usage:
   #        maoptagVersion "comment"
   #        maoptagVersion

   export oldpwd=$(pwd);
   cd /Users/sdo/Downloads/MyMAOP/V1/Sites/cgi-bin;
   export ALBUM_VERSION="$(grep Version ./album.cgi|cut -d':' -f2|sed 's/\ \{1,\}//g')";
   echo "---->$ALBUM_VERSION";
   sed '1,30s/\(my \$VERSION=\"\).\{1,\}$/\1'"$ALBUM_VERSION"'\";/' ./album.cgi>&./album.cgi.tmp
   mv album.cgi.tmp album.cgi
   if [[ $# > 0 ]] ; then
      echo "Future comment $1";
      git tag -a v${ALBUM_VERSION} -m "$1 (current version ${ALBUM_VERSION})."
   else
      git tag -a v${ALBUM_VERSION} -m "current version ${ALBUM_VERSION}."
   fi
   cd ${oldpwd}
}

start(){
	if [ -f $HOME/\ .myalias ]; then
		mv $HOME/\ .myalias $HOME/.myalias ;
	fi
	source ~/.myalias  ~/.profile
}

# MAOP gets saved data from trip (only days +1 (more than one day) 1 (exactly one day) -1 (less than one day)
maopBackupDateAlbumAlpha2Beta(){
   # usage: backupDateMaop n where n can be 0 where 0 is today -760 is 760 days ago
	echo $SHELL;

   export oldpwd=$(pwd);
   cd /Users/sdo/Sites/cgi-bin

	# If no param detected
   if [[ $# -eq 0 ]] ; then
		pwd;
      echo "nothin";
      export mti=0;
      find ./album -type f -mtime ${mti} -print0 | tar cvHzf files.tar.gz --files-from=- --null --exclude=\*backup\*
   else
		# Param(s) are detected
		if [[ "$1" > "$2" ; then
			echo "$param ${Red}NOT OK${Color_Off}" ;
			echo "error ! maopBackupDateAlbumAlpha2Beta [d1 d2]";
			echo "where d1<d2 and have format \"YYYY-MM-DD [HH:MM:SS]\""; 
			return;
		fi
		
		# Validate date format

		for param in "$@"; do
			echo "zsh param: ${Yellow}${param}${Color_Off}";
			echo "${Red}${RE}${Color_Off}";
			date -j -f "%Y%m%d" $param +"%d/%m/%Y" > .stdout.txt 2> .stderr.txt; 
			echo $?; 

			if [[ $param =~ ${RE} ]]; then
				echo "$param ${Green}OK${Color_Off}" ;
			else
				echo "$param ${Red}NOT OK${Color_Off}" ;
				echo "error ! maopBackupDateAlbumAlpha2Beta [d1 d2]";
				echo "where d1<d2 and have format \"YYYY-MM-DD [HH:MM:SS]\""; 
				return;
			fi
			echo "========";
			rm -f stdout.txt stderr.txt
		done

		return ;

      if [[ $# -eq 2 ]] ; then
			pwd;
	      echo "better than nothin";
	      export mti=$1;
	      find ./album -type f -newermt "$1" ! -newermt "$2" -print0 | tar cvHzf files.tar.gz --files-from=- --null --exclude=\*backup\*
      else
      	echo "error ! maopBackupDateAlbumAlpha2Beta [d1 d2]";
			echo "where d1<d2 and have format \"YYYY-MM-DD [HH:MM:SS]\""; 

      fi
   fi
   sshpass -p "${BETAPASSWD}" ssh sdo@beta "tar -C /Users/sdo/Sites/cgi-bin -xz -f-" < files.tar.gz
   cd ${oldpwd}
}

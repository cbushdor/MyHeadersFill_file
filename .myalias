# my album of pictures push a specifig file to distant repo and, local repo: go to cgi script that contains .cgi files copy 
# in a directory the files for loal git directory that push it to network
maop(){
export p=$1;

if test ! -n "$p"; then 
pushd `pwd`;
cd ~/Sites/cgi-bin/;
if test ! -e "$p"; then 
cp $p ~/Documents/Projects/MAOP/V1/src/cgi-bin/;
cd ~/Documents/Projects/MAOP/V1/src/cgi-bin/;
git commit $p;
popd;
else
echo "$0 <file name>";
fi
fi
}


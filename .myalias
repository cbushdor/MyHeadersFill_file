mvpic(){ # begin mvpic()
   mkdir -p ../montoto
      for i in `find . -name "*jpg" -print`; do
         echo $i;
   m=`date +%y%m%d%S%s`;
   mv $i ../montoto/$m.jpg;
   sleep 3;
   done;
} # end mvpic()

rnpic(){ # begin rnpic()
   r=$1;
   mkdir -p $r;
   for i in `find . -name "*jpg" -print`; do
      echo $i;
   m=`date +%y%m%d%S%s`;
   mv $i $r/creampie$m.jpg;
   sleep 3;
   done;
} # end rnpic()

# renames any kind of file in the current directory
iog(){ # begin iog()
   for i in `ls $*|sed 's! !--!g'`; do
      p="`echo $i|cut -d. -f2`";
   a=`date +%s`;
   o="`echo $i|sed 's!--! !g'`";
   echo $i;
   mv "$o" $a.$p; 
#		echo "$o $a.$p ($p)"; 
   sleep 3;
   done
} # end iog()

# special wget
mwget(){ # begin mwget()
   date;
#echo $1;
   mkdir -p ~/Movies/download/;
   cd ~/Movies/download/;
   for i in $* ; do
      export a=`echo $i |sed 's/http:\/\//.\/\_/'|sed 's/[^\/]*$//'`;
   export c=`echo $i |sed 's/http:\/\//.\/\+/'|sed 's/[^\/]*$//'|cut -d'/' -f2`;
   export b=`echo $i |sed 's/http:\/\//.\/\_/'|sed 's/[^\/]*$//'|cut -d'/' -f2`;
#	echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>";
#	echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>$a";
#	echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>";
   if test ! -d "$a" ; then
      echo "create path $a";
   mkdir -p "$a";
   fi
      cd "$a";
   date>>~/.e;
   echo "clear;mwget \"$i\";">>~/.e;
   \wget -c  $i; 
   cd ~/Movies/download/;
   done
#	mv $b $c;
} # end mwget()

# transform file *.pdf to *.pdf but file file na contains spaces it replaces them with _ character
trans(){
   for i in `ls *pdf|sed 's! !_!g'`; do export u=`echo $i|sed 's!_! !g'`;echo "$u --> $i"; mv "$u" $i;done
}

# text file to pdf command line
tf2p(){
   [[ "$1" =~ ((test[0-9]).sh) ]] ; if [[ ${BASH_REMATCH[*]} -gt 0 ]] ; then cat  ${BASH_REMATCH[1]} | text2pdf -o ${BASH_REMATCH[2]}.pdf && echo "${BASH_REMATCH[1]} -> ${BASH_REMATCH[2]}.pdf" ; else echo "$1 not found"; fi
}

# Creates from pod the corresponding html documentation
docPerl6(){
   export p=`pwd`;
   export v='/Users/sdo/Documents/Projects/Perl6';
   cd $v;
   mkdir -p /Users/sdo/Sites/Perl6/Pod/{course,specs};
   for i in `find . -name "*pod" -print`; do
      export oo="$HOME/Sites/Perl6/`echo $i|sed 's/[^/]*pod$//'`";
   if test ! -d "$oo" ; then mkdir -p $oo; fi
      export e="$HOME/Sites/Perl6/`echo $i|sed 's!\.pod$!\.html!'`";
   echo "$i  - $e";
   perl -MPod::Simple::HTML -e Pod::Simple::HTML::go $i $e;
   done
      cd $p;
}

# Cleans documentation html perl pod
cleandocPerl6(){
   export p=`pwd`;
   cd /Users/sdo/Documents/Projects/Perl6;
   mkdir -p /Users/sdo/Sites/Perl6/Pod/{course,specs};
   find . -name "*html" -exec rm -f {} \; -print
      cd $p;
}


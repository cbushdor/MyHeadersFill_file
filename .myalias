# tool to deal with the calculus web site option
# copy id from id13*.php witch are the reference 
# to use it need to be in the Calculus directory
myid(){
	if [ -f "../Calculus.Old/id$1_m.htm" -a $1 -gt 13 ]; then
#echo "file exists"
		for i in `ls id13*php|grep -v \_m|grep -v \_l`; do
			export a=`echo $i|sed s/13/$1/`
				cp -i $i  $a
				done;

	cp -i ../Calculus.Old/id$1_m.htm id$1_m.php
		cp -i ../Calculus.Old/id$1_l.htm id$1_l.php
	else
		printf "${RED}impossible to create id$1*.php${NC}\n"
			fi
}

# blur picture
myblur(){
	export meol=`ls "$@"|cat -e|sed 's/\ \$$/MY\_EOL/g'`;
	export msp=`echo $meol|sed 's/\ /MY\_SPACE/g'`;
	export ms=`echo $msp|sed 's/MY\_EOL[\$]\{0,1\}/\ /g'`;
	export msu=`echo $ms|sed 's/\$$//g'`;
	for i in `echo $msu|sed 's/\$MY_SPACE/\ /g'`; do
		export mns=`echo $i|sed 's/[\$]\{0,1\}MY\_SPACE/\ /g'`;
	echo "$mns";
	export nn="blured-$mns";
	export nngs="gs-$mns";
	convert "$mns" -blur 0x3.0 "$nn" 
		convert "$nn" -colorspace Gray "$nngs"
		echo "#----------------------------";
	cp -p "$nngs" $destdir;
	rm -f "$nngs" "$nn" 
		done;
}

# blur vide
myvblur(){
	export meol=`ls "$@"|cat -e|sed 's/\ \$$/MY\_EOL/g'`;
	export msp=`echo $meol|sed 's/\ /MY\_SPACE/g'`;
	export ms=`echo $msp|sed 's/MY\_EOL[\$]\{0,1\}/\ /g'`;
	export msu=`echo $ms|sed 's/\$$//g'`;
	echo mkdir -f $destdir;
	mkdir -p $destdir;
	for i in `echo $msu|sed 's/\$MY_SPACE/\ /g'`; do
		export mns=`echo $i|sed 's/[\$]\{0,1\}MY\_SPACE/\ /g'`;
	echo "$mns";
	export bw=`echo bw-$mns|sed 's/avi$/mp4/'`;
	export nn=`echo blured-$mns|sed 's/avi$/mp4/'`;
	export nngs=`echo gs-$mns|sed 's/avi$/mp4/'`;
	echo "$bw";
	echo "$nn";
	export ext=`echo $mns|grep -i "avi$"`;
	export size="${#ext}";
	echo $size;
	if test $size -ge 0 ; then
		ffmpeg -i "$mns" -pix_fmt yuv420p -strict -2 "avi-mp4_$mns.mp4";
	echo "avi detected $mns";
	export mns="avi-mp4_$mns.mp4";
	echo "$mns";
	fi
# Transfo BW
		ffmpeg -i "$mns" -vf hue=s=0  "$bw" ;
# Transfo blur
	ffmpeg -i "$bw"  -filter_complex "[0:v]boxblur=luma_radius=10:chroma_radius=10:luma_power=1[blurred]" -map "[blurred]" "$nn";
#echo "#----------------------------";
	cp -p "$nn" $destdir;
	rm -f "$nngs" "$nn"  "avi-mp4_$mns.mp4" "$bw" ;
	done;
}

# b&w picture
mybw(){
#echo "#----------------------------";
#echo "$@";
	export meol=`ls "$@"|cat -e|sed 's/\ \$$/MY\_EOL/g'`;
#echo $meol;
	export msp=`echo $meol|sed 's/\ /MY\_SPACE/g'`;
#echo $msp;
	export ms=`echo $msp|sed 's/MY\_EOL[\$]\{0,1\}/\ /g'`;
	export msu=`echo $ms|sed 's/\$$//g'`;
#echo $msu;
	for i in `echo $msu|sed 's/\$MY_SPACE/\ /g'`; do
#j=`echo $i|sed s/MY_SPACE/\ /g`;
#echo -n "=>$i";
		export mns=`echo $i|sed 's/[\$]\{0,1\}MY\_SPACE/\ /g'`;
#echo " ->$mns";
	convert "$mns" -monochrome  "bw-$mns"
		echo "$i -> bw-$mns";
	echo "#----------------------------";
	done;
}

transfBW_Blur(){
	echo "`echo $$;`";
	mkdir -p $destdir;
	export ext_img="*gif *jpg *png";
	export ext_vid="*mp4 *avi";
	for i in `find . -type d -print` ; do
		echo $i;
	pwd;
	cd $i;
	export fmy=`ls $ext_img`;
	export s="${#fmy}";
	if test $s -gt 0 ; then
		myblur $ext_img 
			fi
			export fmy=`ls $ext_vid`;
	export s="${#fmy}";
	if test $s -gt 0 ; then
		myvblur $ext_vid 
			fi
			pwd;
	cd - ;
	pwd;
	done
}


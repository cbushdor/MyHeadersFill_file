# Launch Planner
mplanner(){
  export pa=`pwd`;
  export MD=`date "+%Y-%m-%d %H:%M:%S"`
  export MDY=`date "+%Y"`
  cd ~/Documents/My-Proj/LGV
  git pull  >~/.mytrash 2>&1;
  open -W -a Planner
  git commit -m "Planner year $MDY" *  >~/.mytrash 2>&1;
  cd ..;git push >~/.mytrash 2>&1;
  git push;git pull;
  cp -p ~/Documents/My-Proj/LGV/* ~/Sites/Project/LGV/mapr/Gantt
  cp -p ~/Documents/My-Proj/LGV/*.html ~/Downloads/MySchedule/
  cp -p ~/Documents/My-Proj/LGV/*.planner ~/Downloads/MySchedule/
  cd ~/Downloads/MySchedule/
  git commit -m "Planner year $MDY" *  >~/.mytrash 2>&1;
  git push >~/.mytrash 2>&1;
  git push;git pull;
  cd $pa
  rm -f ~/.mytrash
}



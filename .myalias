# Transform text to pdf
texttopdf(){
export fileNoExtension=$(echo $1|sed 's/\..*$//g')
echo "$1 -> $fileNoExtension"
# https://www.imagemagick.org/Usage/text/#caption
cat $1 | \
#a2ps -q -1 --prologue=bold \
a2ps -q -1 \
--center-title="$1 file" \
--header='' --left-footer='' --right-footer='' \
      -o ps_version.ps
      magick ps_version.ps'[0]' \
      -trim +repage  -font "Veteran-Typewriter" -bordercolor white -border 3  ${fileNoExtension}.pdf
}


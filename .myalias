mvpic(){ # begin mvpic()
	mkdir -p ../montoto
		for i in `find . -name "*jpg" -print`; do
			echo $i;
	m=`date +%y%m%d%S%s`;
	mv $i ../montoto/$m.jpg;
	sleep 3;
	done;
} # end mvpic()

rnpic(){ # begin rnpic()
	r=$1;
	mkdir -p $r;
	for i in `find . -name "*jpg" -print`; do
		echo $i;
	m=`date +%y%m%d%S%s`;
	mv $i $r/creampie$m.jpg;
	sleep 3;
	done;
} # end rnpic()

#  how 2 use mktab: mkTab album.cgi login.cgi doc.cgi
mkTab(){ # begin mkTab()
	export MONP="`pwd`"
		cd ~/Sites/cgi-bin;
		rm -rf mydoc;
		mkdir -p mydoc/io;
		echo -n "<center>PERL POD</center><br><br><br><br><center>">mydoc/index.html;
		for ll in $@ ; do
			export o=`cat $ll|grep ^use |grep -v constant|sed 's/use / /g'|wc -l`;
#perldoc -oHTml $ll >mydoc/$ll.html
				if test -f "$ll" ; then
					pod2html $ll >mydoc/$ll.html;
						fi;
						b=`cat mydoc/$ll.html|grep VERSION|sed 's!<p>!!g'|sed 's!</p>!!g'|sed 's!$VERSION!\&nbsp;!g'|sed s!=!!g|sed s/\&\#39\;//g|sed s/\&\#34\;//g`;
	echo -e "		<a href=\"index.$ll.html\">$ll</a>&nbsp;&nbsp; $b\n<br>\n">>mydoc/index.html;
		cat << TOTO>mydoc/index.$ll.html
		<html>
		<head>
		<script language="javascript" src="../../js/menu.js"></script>
		<script>
		my_menu("../..", new Array("Admin",              "Administration",
					"Calculus/default.htm",    "Calculus",
					"Methodology",     "Methodology",
					"NFS",             "Network File System",
					"Perl",            "Perl",
					"teamProject",     "Team"),
				"The Manuals");
	</script>
		</head>
		<body>
TOTO
		echo -e "<br><br><center><table width=75% border=1>\n<tr><th colspan=$o><center>">>mydoc/index.$ll.html
		echo "<a href=\"$ll.html\">$ll</a><br>$b">>mydoc/index.$ll.html
		echo -e "</center></td></tr>">>mydoc/index.$ll.html
		depSimp $ll;
#echo -e "<br><a href=\"javascript:history.back()\">\nback</a>">>mydoc/index.$ll.html
	cat << TOTO>>mydoc/index.$ll.html
		<br>
		<br>
		<br>
		<br>
		<br> <br> <br> <br> <br>
		<br> <br> <br> <br> <br>
		<script>
		footer("http://dorey.sebastien.free.fr","javascript:history.back()");
	</script>
		</body>
		</html>
TOTO
#fi
		done
		echo -en "\n</center>\n<br><br>Last update:`date`">>mydoc/index.html
		tar czvf ${BROOT}/docPerlPodHTML-${CURDATE}.tgz mydoc/ 
		cd ${MONP}
} # end mkTab()

depSimp(){ # begin depSimp()
	export SIMP=`cat $1|grep ^use |grep -v constant|sed 's/use / /g' |sed 's/qw\([^\(]*\)//g'`
		echo "<tr>">>mydoc/index.$1.html
		for i in $SIMP ; do
			o=`echo -n "$i"|sed 's/\;$//g'|sed 's/\:\:/\//'|xargs echo -n`
#perldoc -oHTml $o.pm >mydoc/$o.html
				pod2html  $o.pm >mydoc/$o.html
				rm -f mydoc/{\:*,\(.html,\(\$VERSION\).html}
	if test -f "mydoc/$o.html" ; then
		m=`echo -n "$i"|sed 's/\;$//g'|xargs echo -n`
			pp=`echo $m|grep -v DEFAULT|grep -v flock|grep -v \(`
			if test ! -z "$pp" ; then
#	b=`cat mydoc/$o.html|grep VERSION|xargs echo -n`
				b=`cat mydoc/$o.html|grep VERSION|sed 's!<p>!!g'|sed 's!</p>!!g'|sed 's!$VERSION!\&nbsp;!g'|sed s!=!!g|sed s/\&\#39\;//g|sed s/\&\#34\;//g`
	echo "<td valign=center align=center><a href=\"$o.html\">$m.pm</a><br><i>$b</i></td>">>mydoc/index.$1.html
			else
				if test -z "`echo $m|grep ':DEFAULT'`" ; then
					echo "<td valign=center align=center>$m.pm</td>">>mydoc/index.$1.html
						fi
						fi
						fi
						done
						echo "</tr>">>mydoc/index.$1.html
						echo "</table>">>mydoc/index.$1.html
} # end depSimp()

depDou(){ # begin depDou()
	export SIMPD=`cat album.cgi|grep ^use |grep -v constant|grep packages|sed 's/::/\//g'|sed 's/\;\ use\ / /g'|sed 's/\;/ /g'`

} # end depDou()

getssub(){ # begin getssub()
	grep ^sub $1|sort -d|sed 's/^sub\ //g'|sed 's/{.*//g' 
} # end getssub()

# renames any kind of file in the current directory
iog(){ # begin iog()
	for i in `ls $*|sed 's! !--!g'`; do
		p="`echo $i|cut -d. -f2`";
	a=`date +%s`;
	o="`echo $i|sed 's!--! !g'`";
	echo $i;
	mv "$o" $a.$p; 
#		echo "$o $a.$p ($p)"; 
	sleep 3;
	done
} # end iog()

# special wget
mwget(){ # begin mwget()
	date;
#echo $1;
	mkdir -p ~/Movies/download/;
	cd ~/Movies/download/;
	for i in $* ; do
		export a=`echo $i |sed 's/http:\/\//.\/\_/'|sed 's/[^\/]*$//'`;
	export c=`echo $i |sed 's/http:\/\//.\/\+/'|sed 's/[^\/]*$//'|cut -d'/' -f2`;
	export b=`echo $i |sed 's/http:\/\//.\/\_/'|sed 's/[^\/]*$//'|cut -d'/' -f2`;
#	echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>";
#	echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>$a";
#	echo ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>";
	if test ! -d "$a" ; then
		echo "create path $a";
	mkdir -p "$a";
	fi
		cd "$a";
	date>>~/.e;
	echo "clear;mwget \"$i\";">>~/.e;
	\wget -c  $i; 
	cd ~/Movies/download/;
	done
#	mv $b $c;
} # end mwget()

goPm(){ # begin goPm()
	rm -rf ~/Sites/doc;
	cd ~/Sites/cgi-bin;
	mkdir -p ../doc;chmod 755 ../doc;for i in album.cgi `find io -name "*pm" -print` ; do 
		export a=`echo $i|sed 's!.cgi!!'`;
	pod2html --title="$i" --infile=$i --outfile=./$a.html; 
	mv ./$a.html ../doc;done
		export b=`./album.cgi service=ver`;
	cd ../doc;
	echo "<center>album v$b</center><br><br><br>">index.html;
	echo "<center>">>index.html;
	for i in `ls *html` ; do echo "<a href='$i'>$i</a><br>">>../doc/index.html; done
		echo "</center>">>index.html;
} # end goPm()

gogo(){ # begin gogo()
	for i in `ls parser[1-4].pl`; do
		export a="res.$$";
	echo "$i">>time;echo -n "`date +%s`  ">>time;./$i>$a; date +%s>>time;
	cat $a>>report
		echo "-------------------">>report;
	rm -f $a
		done
		cat time>>report
		txt2pdf ./report
		rm -f time
} # end gogo()

futa(){ # begin futa()
	cd ~/Down*
		for m in {60..90} ; do 
			export ee=`printf "%03d" $m`
				for i in {0..9} ; do 
					for j in {1..3} ; do 
						export y="wget -x -c http://toonstraffic.com/gally/futanaria/$ee/images/0$j.wmv";
	$y;
	export y="";
	done
		done
		done

} # end futa()

# Creates iso
mmkisofs(){
	echo "mkisofs -r -J -joliet-long -allow-lowercase -allow-multidot -V \"`echo $1|sed s/\.iso//`\" -o $1 $2"
		mkisofs -r -J -joliet-long -allow-lowercase -allow-multidot -V "`echo $1|sed s/\.iso//`" -o $1 $2
}

